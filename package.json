{
  "name": "qwik-repro-dispatch-after-render",
  "description": "Qwik 2 rc: event handlers run after native propagation right after render()",
  "engines": {
    "node": ">21"
  },
  "engines-annotation": "Mostly required by sharp which needs a Node-API v9 compatible runtime",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "build.types": "tsc --incremental --noEmit",
    "dev": "vite",
    "fmt": "prettier --write .",
    "fmt.check": "prettier --check .",
    "lint": "eslint \"src/**/*.ts*\"",
    "preview": "vite build && vite preview",
    "start": "vite --open"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@qwik.dev/core": "2.0.0-rc.5",
    "@types/node": "25.6.0",
    "eslint": "10.0.3",
    "eslint-plugin-qwik": "2.0.0-rc.5",
    "globals": "17.0.0",
    "prettier": "3.7.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.56.1",
    "typescript-plugin-css-modules": "latest",
    "vite": "8.2.4",
    "vite-tsconfig-paths": "^4.2.1"
  },
  "allowScripts": {
    "sharp@0.34.5": true
  }
}
